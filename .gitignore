# ==============================================================================
# .gitignore — Plataforma de Questões de Concurso
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Ambientes Virtuais (Virtualenvs)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Configurações e Segredos (NUNCA SUBIR CHAVES)
.env
.env.local
.env.*.local
*.pem
*.key

# Node / Frontend React
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/

# Logs e Auditoria
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dados locais e Downloads de PDFs
data/pdfs/
data/cache/
provas/downloads/

# IDE e Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Antigravity / Gemini IDE local
.gemini/
.agents/
