# ==============================================================================
# .gitignore — Plataforma de Questões de Concurso (Proteção Máxima SecOps)
# ==============================================================================

# Credenciais e Segredos (NUNCA SUBIR PARA O GITHUB)
.env
.env*
*.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python & Ambientes Virtuais
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Bancos de Dados SQLite / Locais
*.db
*.sqlite
*.sqlite3

# Node / Frontend React
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/

# Logs e Auditoria
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dados locais e Downloads de PDFs
data/pdfs/
data/cache/
provas/downloads/

# IDE e Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Antigravity / IDE local
.gemini/
.agents/
